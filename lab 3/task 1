CREATE DATABASE xyz;
USE xyz;

CREATE TABLE customer(
cust_number VARCHAR(10) PRIMARY KEY,
cust_name VARCHAR(100),
addr VARCHAR(100),
city VARCHAR(50),
state VARCHAR(50),
postcode VARCHAR(10),
contact_no VARCHAR (20)
);
CREATE TABLE product (
prod_code VARCHAR(10) PRIMARY KEY,
prod_desc VARCHAR(100),
unit VARCHAR(20),
sales_price DECIMAL(10,2)
);
CREATE TABLE invoice (
inv_number INT PRIMARY KEY,
inv_date DATE,
cust_number VARCHAR(10),
inv_amount DECIMAL(10,2),
shipped_by VARCHAR(30),
ship_tranckingno VARCHAR(30),
FOREIGN KEY (cust_number)
REFERENCES customer(cust_number)
);

CREATE TABLE invoice_line (
inv_number INT,
prod_code VARCHAR(10),
quantity INT,
sales_price DECIMAL(10,2),
total_sales DECIMAL(10,2),
PRIMARY KEY (inv_number,prod_code),

FOREIGN KEY (inv_number)
REFERENCES invoice(inv_number),

FOREIGN KEY (prod_code)
REFERENCES product (prod_code)
ON UPDATE CASCADE
);
